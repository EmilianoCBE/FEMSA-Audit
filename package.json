{
  "name": "femsa-audit",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @femsa-audit/api\" \"npm run dev -w @femsa-audit/web\"",
    "dev:web": "npm run dev -w @femsa-audit/web",
    "dev:api": "npm run dev -w @femsa-audit/api",
    "build": "npm run build -w @femsa-audit/web",
    "typecheck": "npm run typecheck -w @femsa-audit/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
